{
  "expo": {
    "name": "Hubmate",
    "slug": "hubmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hubmate.png",
    "scheme": "hubmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/hubmate.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf7f2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hubmate.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/hubmate.png",
        "backgroundColor": "#faf7f2"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
